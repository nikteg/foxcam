# systemd user service for a Linux or WSL worker.
#
#   mkdir -p ~/.config/systemd/user ~/.config/media-worker
#   cp worker/deploy/media-worker.service ~/.config/systemd/user/
#   printf 'MEDIA_SERVER=http://192.168.1.10:8000\nMEDIA_WORKER_TOKEN=msw_...\n' \
#     > ~/.config/media-worker/env && chmod 600 ~/.config/media-worker/env
#   systemctl --user daemon-reload && systemctl --user enable --now media-worker
#   loginctl enable-linger "$USER"      # keep running after logout
#   journalctl --user -u media-worker -f
#
# Assumes `uv tool install` put media-worker in ~/.local/bin (docs/WORKER_SETUP.md).

[Unit]
Description=media-streamer detection worker
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=%h/.config/media-worker/env
ExecStart=%h/.local/bin/media-worker --detector speciesnet
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
